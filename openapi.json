  "info": {
    "title": "Le Jardin des Langues API",
    "description": "API pour l'application d'apprentissage des langues",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Enter JWT token"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Nom d'utilisateur unique",
            "example": "johndoe",
            "minLength": 3,
            "maxLength": 50
          },
          "email": {
            "type": "string",
            "description": "Adresse email valide",
            "example": "john.doe@example.com"
          },
          "password": {
            "type": "string",
            "description": "Mot de passe s\u00e9curis\u00e9",
            "example": "MonMotDePasse123!",
            "minLength": 8
          },
          "name": {
            "type": "string",
            "description": "Nom complet de l'utilisateur",
            "example": "John Doe",
            "maxLength": 100
          },
          "nativeLanguage": {
            "type": "string",
            "description": "Code ISO 639-1 de la langue native",
            "example": "fr"
          },
          "targetLanguage": {
            "type": "string",
            "description": "Code ISO 639-1 de la langue \u00e0 apprendre",
            "example": "zh"
          }
        },
        "required": [
          "username",
          "email",
          "password",
          "name",
          "nativeLanguage",
          "targetLanguage"
        ]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "clx1234567890"
          },
          "username": {
            "type": "string",
            "example": "johndoe"
          },
          "email": {
            "type": "string",
            "example": "john.doe@example.com"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "role": {
            "type": "string",
            "example": "USER",
            "enum": [
              "USER",
              "ADMIN",
              "MODERATOR"
            ]
          },
          "avatarUrl": {
            "type": "string",
            "example": "https://example.com/avatar.jpg"
          },
          "nativeLanguage": {
            "type": "string",
            "example": "fr"
          },
          "targetLanguage": {
            "type": "string",
            "example": "zh"
          },
          "createdAt": {
            "type": "string",
            "example": "2024-01-01T00:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2024-01-01T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "name",
          "role",
          "nativeLanguage",
          "targetLanguage",
          "createdAt",
          "updatedAt"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "emailOrUsername": {
            "type": "string",
            "description": "Email ou nom d'utilisateur",
            "example": "john.doe@example.com"
          },
          "password": {
            "type": "string",
            "description": "Mot de passe",
            "example": "MonMotDePasse123!"
          }
        },
        "required": [
          "emailOrUsername",
          "password"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nom complet de l'utilisateur",
            "example": "John Doe"
          },
          "avatarUrl": {
            "type": "string",
            "description": "URL de l'avatar",
            "example": "https://example.com/avatar.jpg"
          },
          "nativeLanguage": {
            "type": "string",
            "description": "Code ISO 639-1 de la langue native",
            "example": "fr"
          },
          "targetLanguage": {
            "type": "string",
            "description": "Code ISO 639-1 de la langue \u00e0 apprendre",
            "example": "zh"
          },
          "timezone": {
            "type": "string",
            "description": "Fuseau horaire",
            "example": "Europe/Paris"
          },
          "preferences": {
            "type": "object",
            "description": "Pr\u00e9f\u00e9rences utilisateur en JSON",
            "example": "{\"theme\": \"dark\", \"notifications\": true}"
          }
        }
      }
    }
  }
}